# ============================================================
# YYC³ Environment Configuration Template
# 言启象限 | 语枢未来
# ============================================================
# 使用方式：
#   cp .env.example .env.local
#   然后填入真实值。.env.local 已被 .gitignore 排除，严禁提交。
#
# 规范依据：所有凭证必须通过环境变量注入，禁止硬编码于源码或提交入库。
# 变量清单同步维护于 src/config/env.ts 的 ENV_KEYS 常量。
# ============================================================

# ---------- 后端服务地址 ----------
# 自研架构迁移后，此处改为自研网关地址（例如 http://<NAS-IP>:3000/api）
# 当前实现指向 Supabase Edge Function 基地址
VITE_API_BASE_URL=

# ---------- 后端匿名访问令牌 ----------
# 仅限 anon / public 级别。严禁填入 service_role 级别密钥（该密钥可绕过 RLS）
VITE_API_ANON_KEY=

# ---------- Web Push 通知公钥 ----------
# VAPID 公钥（非私钥）。留空则推送订阅不可用，不影响其他功能
VITE_VAPID_PUBLIC_KEY=

# ---------- 真实后端开关 ----------
# true  : 连接真实后端（需同时具备上面两项凭证）
# false : 前端本地演示/离线模式（默认）
# 说明：即使设为 true，若凭证缺失也会被 src/config/env.ts 自动降级为 false
VITE_USE_REAL_BACKEND=false
